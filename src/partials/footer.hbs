        <address class="footer-contacts" aria-label="Наші контакти">
            <h3 class="footer-contacts-title">Зв'яжіться з нами</h3>
            <ul class="footer-contacts-list">
                <li class="footer-contacts-item">
                    <span class="footer-label">Email:</span>
                    <a class="footer-link" href="mailto:{{ studentEmail }}">{{ studentEmail }}</a>
                </li>
                <li class="footer-contacts-item">
                    <span class="footer-label">Телефон:</span>
                    <a class="footer-link" href="tel:+380501112235">+38 (XXX) XXX-XX-XX</a>
                </li>
                <li class="footer-contacts-item">
                    <span class="footer-label">Адреса:</span>
                    <span>— Місто, — Вулиця, — Будинок</span>
                </li>
            </ul>
        </address>
    </div>
</footer>